APP_NAME=Invoice Receipt Extraction API
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/receipt_extraction
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/receipt_extraction
DEMO_API_KEY=dev-demo-key
ADMIN_API_KEY=local-admin-key
DEFAULT_MONTHLY_USAGE_LIMIT=1000
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/tmp/receipt-extraction-uploads
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
